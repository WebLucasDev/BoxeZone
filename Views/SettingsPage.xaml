<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoxeZone.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BoxeZone.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:BoxeZone.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BoxeZone.ViewModels"
    IsTabStop="True"
    PreviewKeyDown="Page_PreviewKeyDown"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <!-- docs/configuracoes.dc.html: 440 px, same container as the widget. -->
    <Grid Width="440" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Voltar, title, Fechar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="BackButton"
                Click="BackButton_Click"
                IsTabStop="False"
                Style="{StaticResource CaptionButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Uid="SettingsTitle"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold" />
            <Button
                x:Uid="CloseButton"
                Grid.Column="2"
                Click="CloseButton_Click"
                IsTabStop="False"
                Style="{StaticResource CloseCaptionButtonStyle}">
                <FontIcon FontSize="10" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Padding="16,8,16,18"
            Spacing="18">

            <!-- Contas -->
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="AccountsHeader"
                    Margin="4,0,0,2"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SectionHeaderForegroundBrush}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Providers}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderViewModel">
                            <controls:AccountCard ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Comportamento -->
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="BehaviorHeader"
                    Margin="4,0,0,2"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SectionHeaderForegroundBrush}" />
                <Border
                    Background="{ThemeResource SettingsCardBackgroundBrush}"
                    BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="StartupTitle" FontSize="13" />
                                <TextBlock
                                    x:Uid="StartupDescription"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="StartupSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.Settings.StartWithWindows, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid
                            Padding="12,10"
                            BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="AlwaysOnTopTitle" FontSize="13" />
                                <TextBlock
                                    x:Uid="AlwaysOnTopDescription"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="AlwaysOnTopSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.Settings.AlwaysOnTop, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid
                            Padding="12,10"
                            BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="CollapseTitle" FontSize="13" />
                                <TextBlock
                                    x:Uid="CollapseDescription"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="CollapseSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.Settings.CollapseAfterUpload, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid
                            Padding="12,10"
                            BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="NotifyTitle" FontSize="13" />
                                <TextBlock
                                    x:Uid="NotifyDescription"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="NotifySwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.Settings.NotifyOnComplete, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Atalho e aparência -->
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="ShortcutHeader"
                    Margin="4,0,0,2"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SectionHeaderForegroundBrush}" />
                <Border
                    Background="{ThemeResource SettingsCardBackgroundBrush}"
                    BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="HotkeyTitle"
                                VerticalAlignment="Center"
                                FontSize="13" />
                            <Border
                                Grid.Column="1"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                BorderBrush="{ThemeResource ShortcutBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource ShortcutBadgeForegroundBrush}"
                                    Text="{x:Bind ViewModel.Settings.HotkeyBadgeText, Mode=OneWay}" />
                            </Border>
                            <Button
                                x:Name="HotkeyButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="HotkeyButton_Click"
                                Content="{x:Bind ViewModel.Settings.HotkeyButtonText, Mode=OneWay}"
                                Style="{StaticResource LinkActionButtonStyle}" />
                        </Grid>
                        <TextBlock
                            Margin="12,0,12,10"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.Settings.HotkeyError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:BindConverters.VisibleWhenText(ViewModel.Settings.HotkeyError), Mode=OneWay}" />

                        <Grid
                            Padding="12,10"
                            BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ThemeTitle"
                                VerticalAlignment="Center"
                                FontSize="13" />
                            <Border
                                Grid.Column="1"
                                Padding="2"
                                Background="{ThemeResource SegmentTrackBrush}"
                                CornerRadius="6">
                                <StackPanel
                                    x:Uid="ThemeSelector"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <RadioButton
                                        x:Uid="ThemeSystem"
                                        Checked="ThemeSystem_Checked"
                                        GroupName="Theme"
                                        IsChecked="{x:Bind ViewModel.Settings.IsSystemTheme, Mode=OneWay}"
                                        Style="{StaticResource SegmentRadioButtonStyle}" />
                                    <RadioButton
                                        x:Uid="ThemeLight"
                                        Checked="ThemeLight_Checked"
                                        GroupName="Theme"
                                        IsChecked="{x:Bind ViewModel.Settings.IsLightTheme, Mode=OneWay}"
                                        Style="{StaticResource SegmentRadioButtonStyle}" />
                                    <RadioButton
                                        x:Uid="ThemeDark"
                                        Checked="ThemeDark_Checked"
                                        GroupName="Theme"
                                        IsChecked="{x:Bind ViewModel.Settings.IsDarkTheme, Mode=OneWay}"
                                        Style="{StaticResource SegmentRadioButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
