<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BoxeZone.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!--
        A Canvas measures its child without the window's size as a limit, so Root
        always reports the size the content wants and the window is resized to match.
    -->
    <Canvas>
        <Grid
            x:Name="Root"
            Width="300"
            Background="{ThemeResource ContainerBackgroundBrush}">
            <Frame x:Name="ContentFrame" />
        </Grid>
    </Canvas>
</Window>
