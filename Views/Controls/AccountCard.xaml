<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BoxeZone.Views.Controls.AccountCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:BoxeZone.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- One provider in Settings > Contas (docs/configuracoes.dc.html). -->
    <Border
        Background="{ThemeResource SettingsCardBackgroundBrush}"
        BorderBrush="{ThemeResource SettingsCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
            <!-- Account: icon, name + status, Conectar/Desconectar -->
            <Grid Padding="12,10,10,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    Background="{ThemeResource ProviderIconBackgroundBrush}"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{ThemeResource ProviderIconForegroundBrush}"
                        Text="{x:Bind ViewModel.Initial, Mode=OneWay}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Text="{x:Bind ViewModel.Name, Mode=OneWay}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.AccountStatus, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ToggleAccountCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.AccountAction, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanChangeAccount, Mode=OneWay}"
                    Style="{StaticResource AccountButtonStyle}" />
            </Grid>

            <!-- Destination folder, only once connected -->
            <StackPanel
                BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                <Grid Padding="12,8,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center">
                        <Path
                            Width="16"
                            Height="16"
                            Data="M1.5,4 L6.5,4 L8,5.5 L14.5,5.5 L14.5,13.5 L1.5,13.5 Z"
                            Stretch="None"
                            Stroke="{ThemeResource TextSecondaryBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.3" />
                    </Viewbox>
                    <TextBlock
                        x:Uid="TargetFolderLabel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{x:Bind ViewModel.TargetFolder, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:BindConverters.CollapsedWhen(ViewModel.IsEditingFolder), Mode=OneWay}" />
                    <TextBox
                        x:Name="FolderBox"
                        x:Uid="FolderBox"
                        Grid.Column="2"
                        MinHeight="28"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        FontSize="12"
                        KeyDown="FolderBox_KeyDown"
                        Text="{x:Bind ViewModel.FolderDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.IsEditingFolder, Mode=OneWay}" />

                    <Button
                        x:Uid="ChangeFolderButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Click="ChangeFolderButton_Click"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Visibility="{x:Bind helpers:BindConverters.CollapsedWhen(ViewModel.IsEditingFolder), Mode=OneWay}" />
                    <Button
                        x:Uid="SaveFolderButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SaveFolderCommand, Mode=OneWay}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsEditingFolder, Mode=OneWay}" />
                </Grid>
                <TextBlock
                    Margin="12,0,10,8"
                    FontSize="11"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.FolderError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:BindConverters.VisibleWhenText(ViewModel.FolderError), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
