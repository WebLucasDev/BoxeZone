<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BoxeZone.Views.Controls.AccountCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:BoxeZone.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- One provider in Settings > Contas (docs/configuracoes.dc.html). -->
    <Border
        Background="{ThemeResource SettingsCardBackgroundBrush}"
        BorderBrush="{ThemeResource SettingsCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
            <!-- Account: icon, name + status, Conectar/Desconectar -->
            <Grid Padding="12,10,10,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    Background="{ThemeResource ProviderIconBackgroundBrush}"
                    CornerRadius="6">
                    <Image Width="18" Height="18">
                        <Image.Source>
                            <SvgImageSource UriSource="{x:Bind ViewModel.Logo, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Text="{x:Bind ViewModel.Name, Mode=OneWay}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.AccountStatus, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ToggleAccountCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.AccountAction, Mode=OneWay}"
                    Style="{StaticResource AccountButtonStyle}" />
            </Grid>

            <!-- Destination folder, only once connected -->
            <StackPanel
                BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                <Grid Padding="12,8,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center">
                        <Path
                            Width="16"
                            Height="16"
                            Data="M1.5,4 L6.5,4 L8,5.5 L14.5,5.5 L14.5,13.5 L1.5,13.5 Z"
                            Stretch="None"
                            Stroke="{ThemeResource TextSecondaryBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.3" />
                    </Viewbox>
                    <TextBlock
                        x:Uid="TargetFolderLabel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{x:Bind ViewModel.TargetFolder, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:BindConverters.CollapsedWhen(ViewModel.IsEditingFolder), Mode=OneWay}" />
                    <TextBox
                        x:Name="FolderBox"
                        x:Uid="FolderBox"
                        Grid.Column="2"
                        MinHeight="28"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        FontSize="12"
                        KeyDown="FolderBox_KeyDown"
                        Text="{x:Bind ViewModel.FolderDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.IsEditingFolder, Mode=OneWay}" />

                    <Button
                        x:Uid="BrowseFolderButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.BrowseFoldersCommand, Mode=OneWay}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Visibility="{x:Bind FolderActionsVisibility(ViewModel.IsEditingFolder, ViewModel.IsBrowsingFolders), Mode=OneWay}" />
                    <Button
                        x:Uid="ChangeFolderButton"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Click="ChangeFolderButton_Click"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Visibility="{x:Bind FolderActionsVisibility(ViewModel.IsEditingFolder, ViewModel.IsBrowsingFolders), Mode=OneWay}" />
                    <Button
                        x:Uid="SaveFolderButton"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SaveFolderCommand, Mode=OneWay}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsEditingFolder, Mode=OneWay}" />
                </Grid>

                <!-- "Procurar…": the provider's folders, one level at a time. -->
                <StackPanel
                    Padding="12,0,10,10"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.IsBrowsingFolders, Mode=OneWay}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Uid="BrowseUpButton"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.BrowseUpCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanBrowseUp, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.BrowsePath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Border
                        BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ScrollViewer MaxHeight="180">
                            <StackPanel>
                                <ItemsRepeater x:Name="BrowseList" ItemsSource="{x:Bind ViewModel.BrowseFolders}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button
                                                Padding="10,6"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind}"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="BrowseFolder_Click"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                                                    <TextBlock FontSize="12" Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock
                                    Padding="10,8"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="{x:Bind ViewModel.BrowseMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasBrowseMessage, Mode=OneWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <TextBlock
                        x:Uid="BrowseGoogleNote"
                        FontSize="11"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowsOnlyAppFolders}" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            x:Uid="BrowseCancelButton"
                            Command="{x:Bind ViewModel.CancelFolderEditCommand, Mode=OneWay}"
                            Style="{StaticResource LinkActionButtonStyle}" />
                        <Button
                            x:Uid="BrowseUseButton"
                            Command="{x:Bind ViewModel.UseBrowsedFolderCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanBrowseUp, Mode=OneWay}"
                            Style="{StaticResource LinkActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Margin="12,0,10,8"
                    FontSize="11"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.FolderError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:BindConverters.VisibleWhenText(ViewModel.FolderError), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
