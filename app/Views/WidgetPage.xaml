<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoxeZone.Views.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BoxeZone.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BoxeZone.ViewModels"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid Width="300" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                Background="{StaticResource BoxeZoneAccentBrush}"
                CornerRadius="5">
                <!-- Boxing glove, same geometry as Assets/BoxeZone-small.svg (without the tile). -->
                <Viewbox Width="18" Height="18">
                    <Canvas Width="256" Height="256">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="40" CenterX="132" CenterY="128" />
                                <TranslateTransform X="-6" Y="4" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Rectangle
                            Canvas.Left="98"
                            Canvas.Top="184"
                            Width="86"
                            Height="48"
                            Fill="{StaticResource OnAccentForegroundBrush}"
                            RadiusX="12"
                            RadiusY="12" />
                        <Path Data="M104,172 C98,150 96,128 98,108 C100,56 126,26 162,28 C194,30 210,60 206,100 C202,136 192,156 178,172 Z" Fill="{StaticResource OnAccentForegroundBrush}" />
                        <Path
                            Data="M100,172 C78,162 66,138 70,116 C74,94 92,86 110,92 C127,99 132,118 123,134 C116,147 109,159 107,172 Z"
                            Fill="{StaticResource OnAccentForegroundBrush}"
                            Stroke="{StaticResource BoxeZoneAccentBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="16" />
                    </Canvas>
                </Viewbox>
            </Border>

            <TextBlock
                x:Uid="HeaderTitle"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold" />

            <Button
                x:Uid="MinimizeButton"
                Grid.Column="2"
                Click="MinimizeButton_Click"
                IsTabStop="False"
                Style="{StaticResource CaptionButtonStyle}">
                <FontIcon FontSize="10" Glyph="&#xE921;" />
            </Button>

            <Button
                x:Uid="CloseButton"
                Grid.Column="3"
                Click="CloseButton_Click"
                IsTabStop="False"
                Style="{StaticResource CloseCaptionButtonStyle}">
                <FontIcon FontSize="10" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <!-- Providers -->
        <StackPanel Grid.Row="1" Padding="6,0,6,6">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Providers}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderViewModel">
                        <controls:ProviderRow ViewModel="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock
                x:Uid="NoProviderHint"
                Margin="10,6,10,10"
                FontSize="12"
                Foreground="{ThemeResource TextSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasNoProviderEnabled, Mode=OneWay}" />
        </StackPanel>

        <!-- Footer -->
        <Grid
            Grid.Row="2"
            Padding="12,8"
            BorderBrush="{ThemeResource FooterBorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Padding="6,1"
                    BorderBrush="{ThemeResource HotkeyBadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource HotkeyBadgeForegroundBrush}"
                        Text="{x:Bind ViewModel.Settings.HotkeyText, Mode=OneWay}" />
                </Border>
                <TextBlock
                    x:Uid="FooterHotkeyHint"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <HyperlinkButton
                x:Uid="SettingsLink"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="SettingsLink_Click"
                FontSize="11" />
        </Grid>
    </Grid>
</Page>
