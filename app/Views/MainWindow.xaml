<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BoxeZone.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BoxeZone.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BoxeZone.ViewModels"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!--
        A Canvas measures its child without the window's size as a limit, so Root
        always reports the size the content wants and the window is resized to match.
    -->
    <Canvas>
        <Grid x:Name="Root" Background="{ThemeResource ContainerBackgroundBrush}">

            <!-- Normal: the widget -->
            <!-- Each page sets its own width: 300 px widget, 440 px Settings. -->
            <Frame x:Name="ContentFrame" />

            <!-- Docked: thin strip on the screen edge -->
            <Grid
                x:Name="DockedStrip"
                x:Uid="DockedStrip"
                Width="12"
                Height="104"
                AllowDrop="True"
                Background="{StaticResource BoxeZoneAccentBrush}"
                DragEnter="DockedStrip_DragEnter"
                PointerPressed="DockedStrip_PointerPressed"
                PointerEntered="DockedStrip_PointerEntered"
                PointerExited="DockedStrip_PointerExited"
                Visibility="Collapsed">
                <Border
                    Width="2"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource DockedStripLineBrush}"
                    CornerRadius="1" />
            </Grid>

            <!-- Docked, a file dragged over the strip: only the drop zones -->
            <StackPanel
                x:Name="CompactPanel"
                Width="200"
                Padding="10"
                Spacing="8"
                Visibility="Collapsed">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.EnabledProviders}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderViewModel">
                            <controls:ProviderRow IsCompact="True" ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    x:Uid="NoProviderHint"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoProviderEnabled, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Canvas>
</Window>
