<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoxeZone.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:BoxeZone.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BoxeZone.ViewModels"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <!-- docs/historico.dc.html: same container and header as Settings (440 px). -->
    <Grid Width="440" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Voltar, title, Fechar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="BackButton"
                Click="BackButton_Click"
                IsTabStop="False"
                Style="{StaticResource CaptionButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Uid="HistoryTitle"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold" />
            <Button
                x:Uid="CloseButton"
                Grid.Column="2"
                Click="CloseButton_Click"
                IsTabStop="False"
                Style="{StaticResource CloseCaptionButtonStyle}">
                <FontIcon FontSize="10" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Padding="16,8,16,14"
            Spacing="10">
            <TextBlock
                x:Uid="HistoryEmpty"
                Margin="4,8"
                FontSize="12"
                Foreground="{ThemeResource TextSecondaryBrush}"
                Visibility="{x:Bind ViewModel.History.IsEmpty, Mode=OneWay}" />

            <!-- Up to 50 entries: the list scrolls instead of growing the window. -->
            <ScrollViewer MaxHeight="440">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.History.Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <Border
                                Background="{ThemeResource SettingsCardBackgroundBrush}"
                                BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid Padding="12,8,12,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="28"
                                        Height="28"
                                        Background="{ThemeResource ProviderIconBackgroundBrush}"
                                        CornerRadius="6">
                                        <Image Width="18" Height="18">
                                            <Image.Source>
                                                <SvgImageSource UriSource="{x:Bind Logo}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <HyperlinkButton
                                        x:Uid="OpenUploadedLink"
                                        Grid.Column="2"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind OpenCommand}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Visibility="{x:Bind CanOpen}" />
                                    <HyperlinkButton
                                        Grid.Column="3"
                                        MaxWidth="150"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind CopyLinkCommand}"
                                        Content="{x:Bind CopyLinkLabel, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Button
                x:Uid="ClearHistoryButton"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.History.ClearCommand}"
                Style="{StaticResource LinkActionButtonStyle}"
                Visibility="{x:Bind helpers:BindConverters.CollapsedWhen(ViewModel.History.IsEmpty), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
